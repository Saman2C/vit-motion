# Normalise line endings in the repository, check out native on Windows.
* text=auto eol=lf

# Windows batch/PowerShell keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diffed, never line-ending-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.zip binary
*.pt binary
*.mp4 binary
*.m4a binary

# Notebooks are JSON, but a textual diff of one is unreadable. Treat them as
# text for storage (so line endings normalise) and suppress the diff.
*.ipynb text -diff
